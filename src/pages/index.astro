const modalityAnchors = ['bjj-kimono', 'nogi', 'privadas', 'open-mat'];
const modalities = content.modalities.map(([title, copy], index) => ({
  n: String(index + 1).padStart(2, '0'),
  title,
  copy,
  href: `${localizedPath('/clases', locale)}#${modalityAnchors[index]}`,
}));
const wa = (message?: string) => whatsappUrl(message, locale);
---

<BaseLayout>
  <section class="hero">
    <Image
      class="hero__image"
      src={heroImage}
      alt=""
      width={1919}
      height={853}
      format="webp"
      quality={88}
      priority
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__veil"></div>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="shell hero__inner">
      <div class="hero__content">
        <h1 set:html={content.heroTitle} />
        <p class="hero__lead">{content.heroLead}</p>
        <div class="button-row">
          <a class="btn btn--lime" href={wa()} target="_blank" rel="noreferrer">
            <Icon name="whatsapp" /> {content.tryAction}
          </a>
          <a class="btn btn--outline" href="#horarios">
            {content.scheduleAction} <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label={content.trustLabel}>
    <div class="trust-strip__track">
      <div class="trust-strip__group">
        {content.trust.map((item) => <><span>{item}</span><i>✦</i></>)}
      </div>
      <div class="trust-strip__group trust-strip__group--repeat" aria-hidden="true">
        {content.trust.map((item) => <><span>{item}</span><i>✦</i></>)}
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="shell">
      <SectionHeading
        eyebrow={content.audienceTitle}
        title={content.audienceTitle}
        copy={content.audienceCopy}
      />
      <div class="audience-grid">
        {content.audiences.map(([title, copy], index) => (
          <article style={`--audience-bg: url('${audienceImages[index].src}')`}>
            <div class="audience-card__shade"></div>
            <div class="audience-card__content">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell split">
      <div class="image-frame class-photo">
        <Image
          src={classImage}
          alt={content.classAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 100vw, 50vw"
          format="webp"
          quality={82}
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="prose-lead">{content.aboutTitle}</h2>
        <p class="body-copy">{content.aboutCopy}</p>
        <ul class="check-list">
          <li>{content.aboutItems[0]}</li>
          <li>{content.aboutItems[1]}</li>
          <li>{content.aboutItems[2]}</li>
          <li>{content.aboutItems[3]}</li>
          <li>{content.aboutItems[4]}</li>
        </ul>
        <a class="text-link" href={localizedPath('/comunidad', locale)}>{content.trainingAction} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell">
      <SectionHeading
        eyebrow={content.modalitiesTitle}
        title={content.modalitiesTitle}
        copy={content.modalitiesCopy}
        light
      />
      <div class="modalities">
        {modalities.map((item) => (
          <a href={item.href}>
            <span>{item.n}</span>
            <div><h3>{item.title}</h3><p>{item.copy}</p></div>
            <Icon name="arrow" size={28} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--lime start-section">
    <div class="shell start-grid">
      <div class="start-intro">
        <h2>{content.startTitle}</h2>
        <p>{content.startCopy}</p>
      </div>
      <div class="start-steps">
        <article>
          <span>01</span>
          <div>
            <h3>{content.startSteps[0][0]}</h3>
            <p>{content.startSteps[0][1]}</p>
          </div>
        </article>
        <article>
          <span>02</span>
          <div>
            <h3>{content.startSteps[1][0]}</h3>
            <p>{content.startSteps[1][1]}</p>
          </div>
        </article>
        <div class="start-action">
          <a class="btn btn--white" href={wa()} target="_blank" rel="noreferrer">
            {content.tryShort} <Icon name="whatsapp" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper" id="horarios">
    <div class="shell">
      <SectionHeading
        eyebrow={content.scheduleTitle}
        title={content.scheduleTitle}
        copy={content.scheduleCopy}
      />
      <Schedule />
      <p class="note"><Icon name="clock" size={17} /> {content.scheduleNote}</p>
      <div class="schedule-actions">
        <a class="btn btn--dark" href={wa(content.confirmMessage)} target="_blank" rel="noreferrer">
          {content.confirmAction} <Icon name="whatsapp" />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="shell">
      <SectionHeading
        eyebrow={content.coachesTitle}
        title={content.coachesTitle}
      />
      <div class="coach-grid">
        <article>
          <div class="coach-grid__image">
            <Image src={fernandoImage} alt={content.coachAlt('Fernando')} widths={[420, 680]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" quality={84} />
            <span>01</span>
          </div>
          <div class="coach-grid__info">
            <div><h3>Fernando</h3><p>{content.coachRole}</p></div>
          </div>
        </article>
        <article>
          <div class="coach-grid__image">
            <Image src={erikImage} alt={content.coachAlt('Erik')} widths={[420, 680]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" quality={84} />
            <span>02</span>
          </div>
          <div class="coach-grid__info">
