    tryAction: 'Try a free class',
    scheduleAction: 'View schedule',
    trustLabel: 'Club values',
    trust: ['Respect', 'Discipline', 'Learning', 'Health', 'Personal growth'],
    audienceTitle: 'Who it is for',
    audienceCopy: 'For children, teenagers, adults, families, competitors, residents and visitors. Everyone is welcome and no previous experience is required.',
    audiences: [
      ['Children and teenagers', 'A friendly place to discover Jiu-Jitsu and grow on and off the mat.'],
      ['Adults of all levels', 'Start from scratch or keep learning if you already have experience.'],
      ['Families', 'A small, family community based on respect and mutual support.'],
      ['Competitors', 'The gym occasionally takes part in competitions and places strong emphasis on technical detail.'],
      ['Self-defence and fitness', 'Technique, control and movement for people who want to take care of themselves and feel more confident.'],
      ['Residents and visitors', 'Train in Cala Galdana whether you live in Menorca or are here on holiday.'],
    ],
    classAlt: 'A technical Jiu-Jitsu class on the mat',
    aboutTitle: 'What is Monkey Menorca Jiu-Jitsu?',
    aboutCopy: 'Monkey Menorca Jiu-Jitsu is a Brazilian Jiu-Jitsu club where we teach much more than a sport. In a friendly environment, we share values such as respect, discipline and personal growth, helping every student develop on and off the mat.',
