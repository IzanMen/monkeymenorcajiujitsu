    faqTitle: 'Frequently asked questions',
    faqCopy: 'Answers based on information provided by the gym.',
    faqs: [
      ['Can I start with no experience?', 'Yes. No previous experience is required: you can start from scratch.'],
      ['Is there a minimum age?', 'There is no set minimum age. Groups are organised by level.'],
