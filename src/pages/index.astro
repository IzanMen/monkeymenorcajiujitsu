import competitorImage from '../assets/photos/pexels-9313037.jpg';
import familyImage from '../assets/photos/pexels-8612042.jpg';

const audienceImages = [
  childrenImage,
  basicsImage,
  openMatImage,
  familyImage,
  competitorImage,
  islandImage,
];

const locale = getLocale(Astro.url);
const content = {
  es: {
    heroTitle: 'Jiu-Jitsu<br />brasileño<br /><em>en Cala Galdana.</em>',
