---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Schedule from '../components/Schedule.astro';
import { whatsappUrl } from '../data/site';
import { getLocale, localizedPath } from '../i18n';
import heroImage from '../assets/photos/pexels-11391978.jpg';
import classImage from '../assets/photos/pexels-8611381.jpg';
import communityImage from '../assets/photos/pexels-35029376.jpg';
import fernandoImage from '../assets/photos/fernando-temp-coach.jpg';
import erikImage from '../assets/photos/erik-temp-coach.avif';
import childrenImage from '../assets/photos/pexels-7988960.jpg';
import basicsImage from '../assets/photos/pexels-8612498.jpg';
