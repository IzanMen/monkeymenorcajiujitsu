---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { whatsappUrl } from '../data/site';
import { getLocale, localizedPath } from '../i18n';
import heroImage from '../assets/photos/coaches-salvador-eric.jpg';
import salvadorImage from '../assets/photos/salvador-coach.jpg';
import fernandoImage from '../assets/photos/fernando-coach.png';
import ericImage from '../assets/photos/eric-machado-coach.webp';
import classImage from '../assets/photos/coaches-training-ground.jpeg';
import calasansImage from '../assets/photos/claudio-calasans.webp';

const locale = getLocale(Astro.url);
const content = {
  es: {
    metaTitle: 'Entrenadores',
    metaDescription: 'Conoce a Salvador, Fernando y Eric Machado, el equipo de entrenadores de Monkey Menorca Jiu-Jitsu, su método y la influencia Calasans.',
    heroTitle: 'Entrenadores',
    heroCopy: 'Salvador, Fernando y Eric Machado forman el equipo de entrenadores de Monkey Menorca Jiu-Jitsu.',
    heroAlt: 'Entrenadores de Monkey Menorca Jiu-Jitsu posando con kimono',
    coachAlt: (name: string) => `${name}, entrenador de Monkey Menorca Jiu-Jitsu`,
    coachRole: 'Entrenador',
    coaches: [
      { name: 'Salvador', image: salvadorImage, bio: '' },
      {
        name: 'Fernando',
        image: fernandoImage,
        bio: 'De Florianópolis al mundo, Fernando lleva 16 años dedicado al Jiu-Jitsu. Formado en la Equipe Araújo Jiu-Jitsu, transmite disciplina, superación y respeto como cinturón negro 1º Dan.',
      },
      { name: 'Eric', image: ericImage, bio: 'Eric Machado es cinturón negro de primer grado e instructor de Jiu-Jitsu. Suma experiencia en entrenamiento personal, enseñanza en Brasil y trabajo con alumnos de todas las edades.' },
    ],
    ericBio: 'Cinturón negro de primer grado e instructor de Jiu-Jitsu desde hace cinco años. Eric suma 15 años de experiencia en entrenamiento personal, ha enseñado en Brasil durante cinco años y trabaja con alumnos de todas las edades, desde niños de tres años hasta adultos mayores. También está especializado en educación inclusiva para personas con autismo y cuenta con trayectoria competitiva tras haberse formado con un campeón mundial.',
    methodTitle: 'Método de enseñanza',
    methodIntro: 'Una enseñanza basada en la línea de Claudio Calasans, adaptada a un entorno más cercano y personalizado.',
    method: [
      ['Línea Calasans', 'El método sigue la línea de trabajo de Claudio Calasans.'],
      ['Atención personalizada', 'El tamaño reducido del gimnasio permite prestar especial atención a cada alumno.'],
      ['Técnica al detalle', 'La enseñanza cuida los detalles y profundiza en la técnica.'],
      ['Aprendizaje continuo', 'Instructores de referencia aportan diferentes estilos en seminarios y entrenamientos especiales.'],
    ],
    influenceTitle: 'Influencia Calasans',
    influenceCopy: ['Monkey Menorca Jiu-Jitsu nace de la inspiración y el apoyo de Albert Ros, de Vallès Jiu-Jitsu, y de las enseñanzas de Claudio Calasans.', 'El proyecto busca crear un intercambio cultural y deportivo con la escuela matriz, fomentando las visitas de alumnos e instructores entre ambos gimnasios.'],
    communityAction: 'Conocer la comunidad',
    seminarsTitle: 'Seminarios e instructores invitados',
    seminarsCopy: 'El gimnasio invita regularmente a instructores de referencia para impartir seminarios y entrenamientos especiales. Así, los alumnos pueden aprender de diferentes estilos y seguir evolucionando.',
    seminarsAction: 'Preguntar por próximos eventos',
    seminarsMessage: 'Hola, quiero información sobre próximos seminarios o campus.',
    seminarsAlt: 'Salvador y Eric Machado entrenando una técnica de Jiu-Jitsu en el tatami',
    learningBadge: 'Siempre<br />aprendiendo',
    ctaTitle: 'Entrenar con el equipo',
    ctaAction: 'Entrenar con el equipo',
    ctaMessage: 'Hola, me gustaría entrenar con el equipo y probar una clase.',
  },
  ca: {
    metaTitle: 'Entrenadors',
    metaDescription: 'Coneix en Salvador, en Fernando i l’Eric Machado, l’equip d’entrenadors de Monkey Menorca Jiu-Jitsu, el seu mètode i la influència Calasans.',
    heroTitle: 'Entrenadors',
    heroCopy: 'En Salvador, en Fernando i l’Eric Machado formen l’equip d’entrenadors de Monkey Menorca Jiu-Jitsu.',
    heroAlt: 'Entrenadors de Monkey Menorca Jiu-Jitsu posant amb quimono',
    coachAlt: (name: string) => `${name}, entrenador de Monkey Menorca Jiu-Jitsu`,
    coachRole: 'Entrenador',
    coaches: [
      { name: 'Salvador', image: salvadorImage, bio: '' },
      {
        name: 'Fernando',
        image: fernandoImage,
        bio: 'De Florianópolis al món, en Fernando porta 16 anys dedicat al Jiu-Jitsu. Format a l’Equipe Araújo Jiu-Jitsu, transmet disciplina, superació i respecte com a cinturó negre 1r Dan.',
      },
      { name: 'Eric', image: ericImage, bio: 'Eric Machado és cinturó negre de primer grau i instructor de Jiu-Jitsu. Aporta experiència en entrenament personal, ensenyament al Brasil i treball amb alumnes de totes les edats.' },
    ],
    ericBio: 'Cinturó negre de primer grau i instructor de Jiu-Jitsu des de fa cinc anys. L’Eric suma 15 anys d’experiència en entrenament personal, ha ensenyat al Brasil durant cinc anys i treballa amb alumnes de totes les edats, des d’infants de tres anys fins a adults grans. També està especialitzat en educació inclusiva per a persones amb autisme i compta amb trajectòria competitiva després d’haver-se format amb un campió mundial.',
    methodTitle: 'Mètode d’ensenyament',
    methodIntro: 'Un ensenyament basat en la línia de Claudio Calasans, adaptat a un entorn més proper i personalitzat.',
    method: [
      ['Línia Calasans', 'El mètode segueix la línia de treball de Claudio Calasans.'],
      ['Atenció personalitzada', 'La mida reduïda del gimnàs permet prestar una atenció especial a cada alumne.'],
      ['Tècnica al detall', 'L’ensenyament cuida els detalls i aprofundeix en la tècnica.'],
      ['Aprenentatge continu', 'Instructors de referència aporten estils diferents en seminaris i entrenaments especials.'],
    ],
    influenceTitle: 'Influència Calasans',
    influenceCopy: ['Monkey Menorca Jiu-Jitsu neix de la inspiració i el suport d’Albert Ros, de Vallès Jiu-Jitsu, i dels ensenyaments de Claudio Calasans.', 'El projecte vol crear un intercanvi cultural i esportiu amb l’escola matriu, fomentant les visites d’alumnes i instructors entre tots dos gimnasos.'],
    communityAction: 'Conèixer la comunitat',
    seminarsTitle: 'Seminaris i instructors convidats',
    seminarsCopy: 'El gimnàs convida regularment instructors de referència per impartir seminaris i entrenaments especials. Així, els alumnes poden aprendre estils diferents i continuar evolucionant.',
    seminarsAction: 'Preguntar pels pròxims esdeveniments',
    seminarsMessage: 'Hola, vull informació sobre els pròxims seminaris o campus.',
    seminarsAlt: 'Salvador i Eric Machado entrenant una tècnica de Jiu-Jitsu al tatami',
    learningBadge: 'Sempre<br />aprenent',
    ctaTitle: 'Entrenar amb l’equip',
    ctaAction: 'Entrenar amb l’equip',
    ctaMessage: 'Hola, m’agradaria entrenar amb l’equip i provar una classe.',
  },
  en: {
    metaTitle: 'Coaches',
    metaDescription: 'Meet Salvador, Fernando and Eric Machado, the coaching team at Monkey Menorca Jiu-Jitsu, their method and the Calasans influence.',
    heroTitle: 'Coaches',
    heroCopy: 'Salvador, Fernando and Eric Machado are the coaching team at Monkey Menorca Jiu-Jitsu.',
    heroAlt: 'Monkey Menorca Jiu-Jitsu coaches posing in gis',
    coachAlt: (name: string) => `${name}, coach at Monkey Menorca Jiu-Jitsu`,
    coachRole: 'Coach',
    coaches: [
      { name: 'Salvador', image: salvadorImage, bio: '' },
      {
        name: 'Fernando',
        image: fernandoImage,
        bio: 'From Florianópolis to the world, Fernando has spent 16 years dedicated to Jiu-Jitsu. Formed at Equipe Araújo Jiu-Jitsu, he shares discipline, resilience and respect as a 1st Dan black belt.',
      },
      { name: 'Eric', image: ericImage, bio: 'Eric Machado is a first-degree black belt and Jiu-Jitsu instructor. He brings experience in personal training, teaching in Brazil and working with students of every age.' },
    ],
    ericBio: 'First-degree black belt and Jiu-Jitsu instructor for five years. Eric brings 15 years of personal training experience, taught at an academy in Brazil for five years and works with students of all ages, from three-year-old children to older adults. He also specialises in inclusive education for people with autism and has a competitive background after training under a world champion.',
    methodTitle: 'Teaching method',
    methodIntro: 'Teaching based on Claudio Calasans’ approach, adapted to a friendlier and more personal environment.',
    method: [
      ['Calasans lineage', 'The method follows Claudio Calasans’ approach to training.'],
      ['Personal attention', 'The gym’s small size allows each student to receive close attention.'],
      ['Detailed technique', 'Teaching focuses on details and develops a deeper understanding of technique.'],
      ['Continuous learning', 'Leading guest instructors bring different styles to seminars and special training sessions.'],
    ],
    influenceTitle: 'The Calasans influence',
    influenceCopy: ['Monkey Menorca Jiu-Jitsu was born from the inspiration and support of Albert Ros from Vallès Jiu-Jitsu, and the teachings of Claudio Calasans.', 'The project aims to create a cultural and sporting exchange with the parent school, encouraging visits by students and instructors between both gyms.'],
    communityAction: 'Discover the community',
    seminarsTitle: 'Seminars and guest instructors',
    seminarsCopy: 'The gym regularly invites leading instructors to teach seminars and special training sessions. This gives students the chance to learn different styles and keep developing.',
    seminarsAction: 'Ask about upcoming events',
    seminarsMessage: 'Hi, I would like information about upcoming seminars or camps.',
    seminarsAlt: 'Salvador and Eric Machado training a Jiu-Jitsu technique on the mat',
    learningBadge: 'Always<br />learning',
    ctaTitle: 'Train with the team',
    ctaAction: 'Train with the team',
    ctaMessage: 'Hi, I would like to train with the team and try a class.',
  },
}[locale];
const wa = (message: string) => whatsappUrl(message, locale);
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
>
  <PageHero
    eyebrow={content.heroTitle}
    title={content.heroTitle}
    copy={content.heroCopy}
    number="05"
    image={heroImage}
    imageAlt={content.heroAlt}
  />

  <section class="coach-list section section--cream">
    <div class="shell coach-list__grid">
      {content.coaches.map((coach) => (
        <article>
          <div class="coach-list__image">
            <Image class:list={['coach-list__photo', coach.name === 'Eric' && 'coach-list__photo--eric']} src={coach.image} alt={content.coachAlt(coach.name)} widths={[520, 820, 1100]} sizes="(max-width: 850px) 100vw, 33vw" format="webp" quality={85} />
          </div>
          <h2>{coach.name}</h2>
          <p class="coach-list__role">{content.coachRole}</p>
          {coach.bio && <p class="coach-list__bio">{coach.bio}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="section section--lime method-section">
    <div class="shell">
      <header class="method-heading">
        <div>
          <h2>{content.methodTitle}</h2>
          <p>{content.methodIntro}</p>
        </div>
        <figure class="method-heading__portrait">
          <Image
            src={calasansImage}
            alt="Claudio Calasans"
            width={136}
            height={136}
            format="webp"
            quality={90}
            loading="lazy"
          />
          <figcaption>Claudio Calasans</figcaption>
        </figure>
      </header>
      <div class="method-grid">
        {content.method.map(([title, copy], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell affiliation">
      <figure class="affiliation__portrait">
        <Image
          src={calasansImage}
          alt="Claudio Calasans con kimono"
          widths={[312, 624]}
          sizes="(max-width: 850px) 100vw, 28vw"
          format="webp"
          quality={92}
          loading="lazy"
        />
        <figcaption>Claudio Calasans</figcaption>
      </figure>
      <div class="affiliation__title">
        <h2>{content.influenceTitle}</h2>
      </div>
      <div class="affiliation__copy">
        {content.influenceCopy.map((item) => <p>{item}</p>)}
        <a class="text-link" href={localizedPath('/comunidad', locale)}>{content.communityAction} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell split">
      <div>
        <h2 class="prose-lead">{content.seminarsTitle}</h2>
        <p class="seminars-copy">{content.seminarsCopy}</p>
        <a class="btn btn--dark" href={wa(content.seminarsMessage)} target="_blank" rel="noreferrer">
          {content.seminarsAction} <Icon name="whatsapp" />
        </a>
      </div>
      <div class="image-frame">
        <Image src={classImage} alt={content.seminarsAlt} widths={[520, 800, 1100]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={84} />
        <span class="image-badge" set:html={content.learningBadge} />
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-band__inner">
      <h2>{content.ctaTitle}</h2>
      <a class="btn btn--dark" href={wa(content.ctaMessage)} target="_blank" rel="noreferrer">
        {content.ctaAction} <Icon name="arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .coach-list__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 2.5rem); }
  .coach-list article { margin: 0; }
  .coach-list__image { position: relative; aspect-ratio: 2 / 3; overflow: hidden; background: var(--ink); }
  .coach-list__image :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .coach-list__image :global(.coach-list__photo--eric) { object-fit: cover; object-position: 22% 50%; }
  .coach-list h2 { margin: 1.2rem 0 0; font-family: var(--font-display); font-size: clamp(4rem, 8.2vw, 8.2rem); font-weight: 400; line-height: .76; letter-spacing: 0; text-transform: uppercase; }
  .coach-list__role { margin: 1rem 0 0; color: var(--red); font-size: .7rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .coach-list__bio { max-width: 42rem; margin: 1rem 0 0; color: var(--muted); font-size: .98rem; line-height: 1.78; }
  .method-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(17,17,15,.25); }
  .method-grid article { min-height: 22rem; display: flex; flex-direction: column; padding: 2rem; border-right: 1px solid rgba(17,17,15,.25); border-bottom: 1px solid rgba(17,17,15,.25); }
  .method-grid article:first-child { border-left: 1px solid rgba(17,17,15,.25); }
  .method-heading { max-width: 72rem; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(2rem, 5vw, 5rem); align-items: end; margin-bottom: clamp(2.5rem, 5vw, 5rem); }
  .method-heading h2 { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(3.6rem, 8vw, 8.3rem); font-weight: 400; line-height: .88; letter-spacing: 0; text-transform: uppercase; text-wrap: balance; }
  .method-heading p { max-width: 44rem; margin: 1.6rem 0 0; color: #000; font-size: clamp(1rem, 1.6vw, 1.25rem); font-weight: 700; line-height: 1.65; }
  .method-heading__portrait { width: 8.5rem; margin: 0; }
  .method-heading__portrait :global(img) { display: block; width: 8.5rem; height: 8.5rem; border: 3px solid var(--ink); border-radius: 50%; object-fit: cover; }
  .method-heading__portrait figcaption { margin-top: .65rem; color: var(--ink); font-size: .63rem; font-weight: 900; letter-spacing: .1em; text-align: center; text-transform: uppercase; }
  .method-grid span { font-family: var(--font-display); font-size: 3rem; font-weight: 300; }
  .method-grid h3 { margin: auto 0 .7rem; font-family: var(--font-display); font-size: 3.2rem; line-height: .8; text-transform: uppercase; }
  .method-grid p { margin: 0; font-size: .82rem; line-height: 1.65; }
  .affiliation { display: grid; grid-template-columns: minmax(14rem, .52fr) 1.05fr .72fr; gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .affiliation__portrait { position: relative; aspect-ratio: 1; margin: 0; overflow: hidden; background: #d3d3d3; }
  .affiliation__portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .affiliation__portrait figcaption { position: absolute; right: 0; bottom: 0; left: 0; padding: .85rem 1rem; background: var(--lime); color: var(--ink); font-size: .68rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .affiliation h2 { margin: 1rem 0 0; font-family: var(--font-display); font-size: clamp(5rem, 10vw, 10rem); font-weight: 400; line-height: .75; letter-spacing: 0; text-transform: uppercase; }
  .affiliation h2 em { color: var(--lime); font-style: normal; }
  .affiliation__copy > p { color: rgba(255,255,255,.72); line-height: 1.75; }
  .seminars-copy { margin: 1.5rem 0 2rem; color: var(--muted); line-height: 1.75; }
  .image-frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 850px) {
    .coach-list__grid, .affiliation { grid-template-columns: 1fr; }
    .method-heading { grid-template-columns: 1fr; }
    .method-heading__portrait { width: 7rem; }
    .method-heading__portrait :global(img) { width: 7rem; height: 7rem; }
    .affiliation__portrait { max-width: 24rem; }
    .method-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 580px) {
    .coach-list__grid {
      width: calc(100% - 1rem);
      margin-right: 0;
      margin-left: 1rem;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(79vw, 19rem);
      gap: .85rem;
      padding-right: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .coach-list article { scroll-snap-align: start; }
    .coach-list h2 { margin-top: .8rem; font-size: 3.25rem; }
    .coach-list__role { margin-top: .7rem; font-size: .62rem; }
    .coach-list__bio { font-size: .84rem; line-height: 1.62; }
    .method-heading {
      grid-template-columns: minmax(0, 1fr) 5.4rem;
      gap: 1rem;
      align-items: start;
      margin-bottom: 2.25rem;
    }
    .method-heading h2 { font-size: clamp(3.05rem, 14.5vw, 3.8rem); line-height: .84; }
    .method-heading p { margin-top: 1rem; font-size: .86rem; line-height: 1.58; }
    .method-heading__portrait { width: 5.4rem; }
    .method-heading__portrait :global(img) { width: 5.4rem; height: 5.4rem; border-width: 2px; }
    .method-heading__portrait figcaption { font-size: .5rem; letter-spacing: .06em; }
    .method-grid {
      margin-right: -1rem;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(84vw, 19rem);
      gap: .75rem;
      padding: 0 1rem .15rem 0;
      border: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .method-grid article {
      min-height: 18rem;
      padding: 1.4rem;
      border: 1px solid rgba(17,17,15,.25);
      scroll-snap-align: start;
    }
    .method-grid article:first-child { border-left: 1px solid rgba(17,17,15,.25); }
    .method-grid span { font-size: 2.25rem; }
    .method-grid h3 { font-size: 2.2rem; }
    .affiliation { gap: 1.75rem; }
    .affiliation__portrait { max-width: none; aspect-ratio: 4 / 3; }
    .affiliation__portrait :global(img) { object-position: center 28%; }
    .affiliation h2 { margin: 0; font-size: clamp(3.7rem, 17vw, 4.6rem); line-height: .8; }
    .affiliation__copy > p, .seminars-copy { font-size: .86rem; line-height: 1.65; }
    .section--paper .split { gap: 2rem; }
    .section--paper .split > .image-frame { grid-row: 1; }
    .section--paper .btn { width: 100%; }
  }
</style>
