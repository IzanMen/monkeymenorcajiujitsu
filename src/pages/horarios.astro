---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Schedule from '../components/Schedule.astro';
import Map from '../components/Map.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../data/site';

const access = [
  ['Tatami', 'Zona amplia, limpia y preparada para el trabajo técnico.'],
  ['Vestuario y duchas', 'Cámbiate y vuelve a tu día con comodidad.'],
  ['Climatización', 'Aire acondicionado y ventilación para entrenar todo el año.'],
  ['Zona de espera', 'Un lugar cómodo para acompañantes y familias.'],
  ['Preparación física', 'Material para completar el trabajo de fuerza y movilidad.'],
  ['Acceso sencillo', 'Local a pie de calle en Cala Galdana.'],
];
---

<BaseLayout
  title="Horarios y ubicación"
  description="Consulta los horarios, Open Mat y la ubicación de Monkey Menorca Jiu-Jitsu en Avenida Costa del Mirador, Cala Galdana."
>
  <PageHero
    eyebrow="Horarios y ubicación"
    title="Tu momento.<br /><em>Tu lugar.</em>"
    copy="Entrena por la mañana o al mediodía, a pocos minutos de la cala. Confirma el horario antes de venir."
    number="04"
  />

  <section class="section section--paper">
    <div class="shell">
      <SectionHeading
        eyebrow="Horario actual"
        title="La semana se<br /><em>mide en rounds.</em>"
        copy="Clases regulares para construir una práctica constante. Llega diez minutos antes si es tu primera vez."
      />
      <Schedule />
      <div class="summer-alert">
        <Icon name="clock" size={28} />
        <div>
          <strong>Horarios sujetos a cambios en verano</strong>
          <p>Menorca cambia de ritmo en temporada. Escríbenos antes de venir y te confirmamos la próxima sesión.</p>
        </div>
        <a class="text-link" href={whatsappUrl('Hola, ¿me podéis confirmar el horario actual?')} target="_blank" rel="noreferrer">
          Confirmar ahora <Icon name="whatsapp" />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell open-mat">
      <div>
        <p class="eyebrow">Sábados · 14:00 — 15:00</p>
        <h2>Open<br /><em>Mat.</em></h2>
      </div>
      <div>
        <p class="quote">“Una hora para probar, preguntar, rodar y compartir.”</p>
        <p class="open-mat__copy">Abierto a la comunidad y a visitantes de otros gimnasios. También anunciamos entrenamientos especiales, seminarios y cambios puntuales por WhatsApp e Instagram.</p>
        <a class="btn btn--lime" href={whatsappUrl('Hola, quiero venir al próximo Open Mat.')} target="_blank" rel="noreferrer">
          Avisar que voy al Open Mat <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="location-intro section section--cream">
    <div class="shell split">
      <div>
        <p class="eyebrow">Cala Galdana · Menorca</p>
        <p class="statement">Entrena donde otros vienen a <em>respirar.</em></p>
      </div>
      <div class="location-details">
        <Icon name="pin" size={38} />
        <h2>{site.address}</h2>
        <p>Un club cercano, integrado en el ritmo de Cala Galdana y con todo lo necesario para entrenar cómodo.</p>
        <a class="btn btn--dark" href={site.mapLink} target="_blank" rel="noreferrer">Cómo llegar <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <Map />

  <section class="section section--paper">
    <div class="shell">
      <SectionHeading eyebrow="Acceso e instalaciones" title="Llegar fácil.<br /><em>Entrenar mejor.</em>" />
      <div class="access-grid">
        {access.map(([title, copy], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-band__inner">
      <h2>¿Vienes a probar? Avísanos y te esperamos.</h2>
      <a class="btn btn--dark" href={whatsappUrl('Hola, voy a probar una clase. ¿Me confirmáis el horario?')} target="_blank" rel="noreferrer">
        Avisar que voy a probar <Icon name="whatsapp" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .summer-alert { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.25rem; margin-top: 2rem; padding: 1.5rem; background: #fff0bd; color: #5e4a00; }
  .summer-alert strong { display: block; margin-bottom: .25rem; font-family: var(--font-display); font-size: 1.35rem; text-transform: uppercase; }
  .summer-alert p { margin: 0; font-size: .82rem; line-height: 1.6; }
  .open-mat { display: grid; grid-template-columns: 1fr .75fr; gap: clamp(3rem, 8vw, 9rem); align-items: end; }
  .open-mat h2 { margin: 1rem 0 0; font-family: var(--font-display); font-size: clamp(7rem, 15vw, 15rem); font-weight: 900; letter-spacing: -.05em; line-height: .65; text-transform: uppercase; }
  .open-mat h2 em { color: var(--lime); font-style: normal; }
  .open-mat__copy { margin: 2rem 0; color: rgba(255,255,255,.6); line-height: 1.75; }
  .location-details { padding: clamp(2rem, 4vw, 4rem); background: var(--lime); }
  .location-details > svg { margin-bottom: 4rem; }
  .location-details h2 { margin: 0 0 1rem; font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4.8rem); font-weight: 800; line-height: .9; text-transform: uppercase; }
  .location-details p { margin: 0 0 2rem; font-size: .9rem; line-height: 1.7; }
  .access-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .access-grid article { min-height: 16rem; padding: 2rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .access-grid span { color: var(--lime-dark); font-size: .65rem; font-weight: 900; letter-spacing: .12em; }
  .access-grid h3 { margin: 4rem 0 .6rem; font-family: var(--font-display); font-size: 2.2rem; line-height: .9; text-transform: uppercase; }
  .access-grid p { margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.65; }
  @media (max-width: 800px) {
    .open-mat { grid-template-columns: 1fr; }
    .summer-alert { grid-template-columns: auto 1fr; }
    .summer-alert .text-link { grid-column: 2; }
    .access-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .access-grid { grid-template-columns: 1fr; }
  }
</style>
