const wa = (message: string) => whatsappUrl(message, locale);
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
>
  <PageHero
    eyebrow={content.heroTitle}
    title={content.heroTitle}
    copy={content.heroCopy}
    number="06"
    image={heroImage}
    imageAlt={content.heroAlt}
  />

  <section class="community-lead">
    <Image
      src={communityImage}
      alt={content.leadAlt}
      widths={[720, 1100, 1600]}
      sizes="100vw"
      format="webp"
      quality={86}
      priority
    />
    <div class="community-lead__shade"></div>
    <div class="shell community-lead__content">
      <h2 class="statement">{content.leadTitle}</h2>
    </div>
  </section>

  <section class="section lifestyle">
    <div class="shell">
      <header class="lifestyle__heading">
        <p class="eyebrow">{content.lifestyleEyebrow}</p>
        <h2 set:html={content.lifestyleTitle} />
      </header>
      <div class="lifestyle__showcase">
        <figure class="lifestyle__image">
          <Image src={islandImage} alt={content.islandAlt} widths={[720, 1100]} sizes="(max-width: 850px) 100vw, 55vw" format="webp" quality={84} />
          <figcaption>
            <span>40° 00' N</span>
            <span>Cala Galdana · Menorca</span>
          </figcaption>
        </figure>
        <div class="lifestyle__copy">
          <span class="lifestyle__number">01</span>
          <p class="lifestyle__label">{content.lifestyleLabel}</p>
        <p class="quote">{content.lifestyleQuote}</p>
        <p>{content.lifestyleCopy}</p>
          <div class="lifestyle__footer">
            <span>{content.lifestyleFooter}</span>
            <Icon name="arrow" size={24} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell">
      <SectionHeading
        eyebrow={content.eventsEyebrow}
        title={content.eventsTitle}
        copy={content.eventsCopy}
        light
      />
      <div class="events-list">
        {content.events.map(([title, copy], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section testimonials-section">
    <div class="shell">
      <header class="testimonials-heading">
        <p class="eyebrow">{content.voices}</p>
        <h2 set:html={content.testimonialsTitle} />
        <p>{content.testimonialsCopy}</p>
      </header>

      <div
        class="testimonial-carousel"
        data-testimonial-carousel
        tabindex="0"
        role="region"
        aria-roledescription={content.carouselDescription}
        aria-label={content.carouselLabel}
      >
        <div class="testimonial-carousel__viewport" aria-live="polite">
          {content.testimonials.map((feedback, index) => (
            <article
              class:list={['testimonial-slide', { 'is-active': index === 0 }]}
              data-testimonial-slide
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <span class="testimonial-slide__number">0{index + 1}</span>
              <span class="testimonial-slide__quote" aria-hidden="true">“</span>
              <p>{feedback}</p>
              <small>{content.testimonialCaption}</small>
            </article>
          ))}
        </div>

        <div class="testimonial-carousel__controls">
          <button type="button" class="testimonial-carousel__arrow testimonial-carousel__arrow--prev" data-testimonial-prev aria-label={content.previous}>
            <Icon name="arrow" size={23} />
          </button>
          <div class="testimonial-carousel__progress">
            <span data-testimonial-current>01</span>
            <div class="testimonial-carousel__dots" aria-label={content.choose}>
              {content.testimonials.map((_, index) => (
                <button
                  type="button"
                  class:list={{ 'is-active': index === 0 }}
                  data-testimonial-dot
                  aria-label={content.chooseNumber(index + 1)}
                  aria-current={index === 0 ? 'true' : undefined}
                ></button>
              ))}
            </div>
            <span>0{content.testimonials.length}</span>
          </div>
          <button type="button" class="testimonial-carousel__arrow" data-testimonial-next aria-label={content.next}>
            <Icon name="arrow" size={23} />
          </button>
        </div>
      </div>
    </div>
  </section>

  <script>
    const carousels = document.querySelectorAll<HTMLElement>('[data-testimonial-carousel]');

    carousels.forEach((carousel) => {
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-testimonial-slide]'));
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-testimonial-dot]'));
      const current = carousel.querySelector<HTMLElement>('[data-testimonial-current]');
      const previous = carousel.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-testimonial-next]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let activeIndex = 0;
      let timer: number | undefined;
      let touchStartX: number | undefined;

      const showSlide = (newIndex: number) => {
        activeIndex = (newIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', String(!isActive));
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          if (isActive) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });

        if (current) current.textContent = String(activeIndex + 1).padStart(2, '0');
      };

      const stopAutoplay = () => {
        if (timer !== undefined) window.clearInterval(timer);
      };
      const startAutoplay = () => {
        stopAutoplay();
        if (!reduceMotion) timer = window.setInterval(() => showSlide(activeIndex + 1), 5500);
      };

      previous?.addEventListener('click', () => {
        showSlide(activeIndex - 1);
        startAutoplay();
      });
      next?.addEventListener('click', () => {
        showSlide(activeIndex + 1);
        startAutoplay();
      });
      dots.forEach((dot, index) => dot.addEventListener('click', () => {
        showSlide(index);
        startAutoplay();
      }));
      carousel.addEventListener('keydown', (event: KeyboardEvent) => {
        if (event.key === 'ArrowLeft') previous?.click();
        if (event.key === 'ArrowRight') next?.click();
      });
      carousel.addEventListener('touchstart', (event: TouchEvent) => {
        touchStartX = event.changedTouches[0]?.clientX;
        stopAutoplay();
      }, { passive: true });
      carousel.addEventListener('touchend', (event: TouchEvent) => {
        const touchEndX = event.changedTouches[0]?.clientX;
        if (touchStartX !== undefined && touchEndX !== undefined) {
          const distance = touchEndX - touchStartX;
          if (Math.abs(distance) > 48) showSlide(activeIndex + (distance < 0 ? 1 : -1));
        }
        touchStartX = undefined;
        startAutoplay();
      }, { passive: true });
      carousel.addEventListener('mouseenter', stopAutoplay);
      carousel.addEventListener('mouseleave', startAutoplay);
      carousel.addEventListener('focusin', stopAutoplay);
      carousel.addEventListener('focusout', startAutoplay);
      startAutoplay();
    });
  </script>

  <section class="gallery section--cream">
    <div class="shell">
      <SectionHeading eyebrow={content.galleryTitle} title={content.galleryTitle} />
      <div class="gallery-grid">
        <figure class="gallery-grid__wide">
          <Image src={classImage} alt={content.galleryAlts[0]} widths={[720, 1200]} sizes="(max-width: 800px) 100vw, 66vw" format="webp" quality={82} />
        </figure>
        <figure class="gallery-grid__portrait">
          <Image src={womenImage} alt={content.galleryAlts[1]} widths={[400, 680]} sizes="(max-width: 800px) 100vw, 33vw" format="webp" quality={82} />
        </figure>
        <figure class="gallery-grid__portrait">
          <Image src={kidsImage} alt={content.galleryAlts[2]} widths={[400, 680]} sizes="(max-width: 800px) 100vw, 33vw" format="webp" quality={82} />
        </figure>
        <figure class="gallery-grid__wide">
          <Image src={nogiImage} alt={content.galleryAlts[3]} widths={[720, 1200]} sizes="(max-width: 800px) 100vw, 66vw" format="webp" quality={82} />
        </figure>
        <figure class="gallery-grid__portrait">
          <Image src={detailImage} alt={content.galleryAlts[4]} widths={[400, 680]} sizes="(max-width: 800px) 100vw, 33vw" format="webp" quality={82} />
        </figure>
        <figure class="gallery-grid__portrait">
          <Image src={communityImage} alt={content.galleryAlts[5]} widths={[400, 680]} sizes="(max-width: 800px) 100vw, 33vw" format="webp" quality={82} />
        </figure>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="shell cta-band__inner">
      <h2>{content.ctaTitle}</h2>
      <a class="btn btn--dark" href={wa(content.ctaMessage)} target="_blank" rel="noreferrer">
        {content.ctaAction} <Icon name="whatsapp" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .community-lead { position: relative; min-height: 50rem; display: flex; align-items: end; overflow: hidden; background: var(--ink); color: white; padding-bottom: clamp(4rem, 8vw, 8rem); }
  .community-lead :global(> img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .community-lead__shade { position: absolute; inset: 0; background: linear-gradient(0deg,rgba(10,10,9,.94),rgba(10,10,9,.05) 72%); }
  .community-lead__content { position: relative; z-index: 1; }
  .community-lead .statement { max-width: 75rem; margin-top: 1.5rem; }
  .community-lead .statement em { color: var(--lime); }
  .lifestyle { background: var(--sand); }
  .lifestyle__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid rgba(17,17,15,.25);
    padding-top: 1.25rem;
  }
  .lifestyle__heading .eyebrow { grid-column: 2; grid-row: 1; margin-top: .45rem; }
  .lifestyle h2 {
    grid-column: 1;
    grid-row: 1;
    max-width: 58rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(4.6rem, 9vw, 9rem);
    font-weight: 400;
    line-height: .76;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .lifestyle__showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(19rem, .72fr);
    align-items: center;
  }
  .lifestyle__image {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .lifestyle__image::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.18);
    pointer-events: none;
  }
  .lifestyle__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s ease;
  }
  .lifestyle__showcase:hover .lifestyle__image :global(img) { transform: scale(1.025); }
  .lifestyle__image figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: linear-gradient(0deg, rgba(10,10,9,.78), transparent);
    color: white;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .lifestyle__copy {
    position: relative;
    z-index: 2;
    margin-left: clamp(-5rem, -5vw, -3rem);
    padding: clamp(2rem, 4vw, 4rem);
    border: 1px solid var(--ink);
    background: var(--lime);
    box-shadow: 1rem 1rem 0 var(--ink);
    color: var(--ink);
  }
  .lifestyle__number {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
  }
  .lifestyle__label {
    margin: 0 0 clamp(3.5rem, 7vw, 6rem);
    font-size: .66rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .lifestyle__copy .quote {
    max-width: 28rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 4.5vw, 4.8rem);
    font-weight: 600;
    line-height: .92;
  }
  .lifestyle__copy > p:not(.quote):not(.lifestyle__label) {
    max-width: 30rem;
    margin: 0;
    font-size: .92rem;
    font-weight: 650;
    line-height: 1.7;
  }
  .lifestyle__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(17,17,15,.35);
    font-size: .65rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .events-list { border-top: 1px solid rgba(255,255,255,.16); }
  .events-list article { display: grid; grid-template-columns: 3rem .7fr 1fr; align-items: center; gap: clamp(1rem, 4vw, 4rem); padding: 2rem 0; border-bottom: 1px solid rgba(255,255,255,.16); }
  .events-list span { color: var(--lime); font-size: .65rem; font-weight: 900; }
  .events-list h3 { margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 4rem); line-height: .9; text-transform: uppercase; }
  .events-list p { margin: 0; color: rgba(255,255,255,.55); font-size: .85rem; line-height: 1.65; }
  .testimonials-section {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px),
      var(--ink);
    background-size: 6rem 6rem;
    color: white;
  }
  .testimonials-section::before {
    content: '';
    position: absolute;
    top: -13rem;
    right: -11rem;
    width: 31rem;
    height: 31rem;
    border: 5rem solid rgba(255,31,31,.08);
    border-radius: 50%;
    pointer-events: none;
  }
  .testimonials-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, .55fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
