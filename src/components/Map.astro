---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLocale, ui } from '../i18n';

const messages = ui[getLocale(Astro.url)];
---

<div class="map-wrap">
  <iframe
    src={site.mapEmbed}
    title={messages.mapTitle}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  <a class="map-card" href={site.mapLink} target="_blank" rel="noreferrer">
    <Icon name="pin" size={26} />
    <span>
      <small>Cala Galdana · Menorca</small>
      <strong>{site.address}</strong>
    </span>
    <Icon name="arrow" size={22} />
  </a>
</div>

<style>
  .map-wrap { position: relative; min-height: 34rem; background: #d9d6ca; overflow: hidden; }
  iframe { width: 100%; height: 34rem; border: 0; filter: grayscale(1) contrast(1.08); }
  .map-card {
    position: absolute;
    left: clamp(1rem, 4vw, 4rem);
    bottom: clamp(1rem, 4vw, 4rem);
    width: min(30rem, calc(100% - 2rem));
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--ink);
    color: white;
    text-decoration: none;
  }
  .map-card > svg:first-child { color: var(--lime); }
  .map-card span { display: grid; gap: .25rem; }
  small { color: var(--lime); font-size: .62rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  strong { font-size: .9rem; line-height: 1.4; }
  @media (max-width: 580px) {
    .map-wrap, iframe { min-height: 24rem; height: 24rem; }
    .map-card {
      left: 1rem;
      bottom: 1rem;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: .75rem;
      padding: 1rem;
    }
    small { font-size: .56rem; }
    strong { font-size: .76rem; overflow-wrap: anywhere; }
  }
</style>
