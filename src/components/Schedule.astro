---
import Icon from './Icon.astro';
import { schedules } from '../data/site';
---

<div class="schedule">
  {schedules.map((item, index) => (
    <article class="schedule__row">
      <span class="schedule__number">{String(index + 1).padStart(2, '0')}</span>
      <div>
        <p>{item.days}</p>
        <strong>{item.type}</strong>
      </div>
      <time>{item.time}</time>
      <Icon name="arrow" size={24} />
    </article>
  ))}
</div>

<style>
  .schedule { border-top: 1px solid var(--line); }
  .schedule__row {
    display: grid;
    grid-template-columns: 3rem 1fr auto 2rem;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    padding: clamp(1.4rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .schedule__number { color: var(--lime-dark); font-size: .7rem; font-weight: 900; letter-spacing: .1em; }
  p { margin: 0 0 .3rem; color: var(--muted); font-size: .78rem; }
  strong {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2.35rem);
    font-weight: 800;
    text-transform: uppercase;
  }
  time {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -.02em;
  }
  @media (max-width: 560px) {
    .schedule__row { grid-template-columns: 2rem 1fr auto; }
    .schedule__row > svg { display: none; }
    time { font-size: 1.65rem; }
  }
</style>
