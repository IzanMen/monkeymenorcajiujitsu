---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLocale, ui } from '../i18n';

interface Props {
  eyebrow: string;
  title: string;
  copy: string;
  number?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, title, copy, number, image, imageAlt = '' } = Astro.props;
const messages = ui[getLocale(Astro.url)];
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden={imageAlt ? 'false' : 'true'}>
    {image && (
      <Image
        class="page-hero__image"
        src={image}
        alt={imageAlt}
        widths={[960, 1440, 2000]}
        sizes="100vw"
        format="webp"
        quality={84}
        priority
      />
    )}
    {image && <div class="page-hero__veil"></div>}
    <div class="page-hero__grid" aria-hidden="true"></div>
  </div>
  <div class="page-hero__body">
    <div class="shell page-hero__inner">
      <div class="page-hero__content">
        <div class="page-hero__meta">
          <p class="eyebrow">{eyebrow}</p>
          {number && <span class="page-hero__number">{number}</span>}
        </div>
        <h1 set:html={title} />
        <p class="page-hero__copy">{copy}</p>
      </div>
    </div>
  </div>
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      <span>{messages.ticker}</span>
      <span class="ticker__repeat">{messages.ticker}</span>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(34rem, 70svh, 48rem);
    display: flex;
    flex-direction: column;
    background: var(--ink);
    color: var(--cream);
    isolation: isolate;
  }
  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  :global(.page-hero__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .page-hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(10,10,9,.96) 0%, rgba(10,10,9,.78) 42%, rgba(10,10,9,.22) 78%, rgba(10,10,9,.08) 100%),
      linear-gradient(0deg, rgba(10,10,9,.82) 0%, rgba(10,10,9,.22) 55%, rgba(10,10,9,.48) 100%);
  }
  .page-hero::after {
    content: '';
    position: absolute;
    width: 34vw;
    aspect-ratio: 1;
    right: -8vw;
    top: -10vw;
    z-index: 0;
    border: 1px solid rgba(255,31,31,.28);
    border-radius: 50%;
    box-shadow: 0 0 0 8vw rgba(255,31,31,.035), 0 0 0 16vw rgba(255,31,31,.025);
  }
  .page-hero__grid {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: .07;
    background-image: linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px);
    background-size: 5rem 5rem;
  }
  .page-hero__body {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    padding: clamp(5rem, 10vw, 8rem) 0 clamp(4rem, 7vw, 6rem);
  }
  .page-hero__inner {
    display: block;
  }
  .page-hero__content { max-width: 70rem; }
  .page-hero__meta,
  .page-hero__copy { display: none; }
  h1 {
    max-width: 70rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 12rem);
    font-weight: 400;
    line-height: .84;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  :global(h1 em) { color: var(--lime); font-style: normal; }
  .ticker { position: relative; z-index: 2; display: flex; justify-content: center; overflow: hidden; background: var(--lime); color: var(--ink); padding: .72rem 0; white-space: nowrap; }
  .ticker__track { min-width: 100%; text-align: center; font-size: .68rem; font-weight: 900; letter-spacing: .15em; }
  .ticker__track span { padding-inline: 1rem; }
  .ticker__repeat { display: none; }
  @media (max-width: 720px) {
    .page-hero { min-height: clamp(36rem, 82svh, 42rem); }
    .page-hero__body { align-items: flex-end; padding: 4.25rem 0 3rem; }
    .page-hero__content { width: 100%; }
    .page-hero__meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .page-hero__meta .eyebrow { color: rgba(255,255,255,.82); }
    .page-hero__number {
      width: 2.65rem;
      height: 2.65rem;
      display: grid;
      flex: 0 0 auto;
      place-items: center;
      border: 1px solid rgba(255,255,255,.34);
      border-radius: 50%;
      color: var(--lime);
      font-size: .65rem;
      font-weight: 900;
      letter-spacing: .08em;
    }
    .page-hero__copy {
      max-width: 34rem;
      display: block;
      margin: 1.35rem 0 0;
      padding-left: 1rem;
      border-left: 2px solid var(--lime);
      color: rgba(255,255,255,.8);
      font-size: .9rem;
      line-height: 1.58;
    }
    .page-hero__veil {
      background:
        linear-gradient(90deg, rgba(10,10,9,.88), rgba(10,10,9,.34)),
        linear-gradient(0deg, rgba(10,10,9,.96) 0%, rgba(10,10,9,.42) 68%, rgba(10,10,9,.56) 100%);
    }
    :global(.page-hero__image) { transform: scale(1.025); animation: mobile-hero-in 1.1s ease-out both; }
    h1 {
      max-width: 100%;
      font-size: clamp(3.15rem, 16vw, 5.2rem);
      line-height: .82;
      text-wrap: balance;
    }
    .ticker { justify-content: flex-start; padding-block: .62rem; }
    .ticker__track {
      width: max-content;
      min-width: 0;
      display: flex;
      text-align: left;
      animation: ticker-mobile 18s linear infinite;
    }
    .ticker__track span { min-width: max-content; padding-inline: 1.25rem; }
    .ticker__repeat { display: inline; }
  }
  @keyframes mobile-hero-in {
    from { opacity: .72; transform: scale(1.08); }
    to { opacity: 1; transform: scale(1.025); }
  }
  @keyframes ticker-mobile {
    to { transform: translateX(-50%); }
  }
</style>
