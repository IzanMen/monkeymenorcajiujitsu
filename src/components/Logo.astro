---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a class:list={['brand', { 'brand--light': light }]} href="/">
  <span class="brand__mark" aria-hidden="true">
    <svg viewBox="0 0 56 56">
      <path d="M7 15 18 7l10 7L38 7l11 8-4 29H11L7 15Z" />
      <path d="m18 22 10 9 10-9M21 40h14" />
    </svg>
  </span>
  <span class="brand__text">
    <strong>MONKEY</strong>
    <small>MENORCA · JIU-JITSU</small>
  </span>
</a>

<style>
  .brand {
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.72rem;
    text-decoration: none;
    min-width: max-content;
  }
  .brand--light { color: var(--cream); }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.65rem;
    height: 2.65rem;
    color: var(--lime);
  }
  svg { width: 100%; height: 100%; }
  svg path:first-child { fill: currentColor; stroke: currentColor; stroke-width: 2; }
  svg path:last-child { fill: none; stroke: var(--ink); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .brand--light svg path:last-child { stroke: var(--ink); }
  .brand__text { display: flex; flex-direction: column; line-height: 0.86; }
  strong {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  small {
    margin-top: 0.38rem;
    font-size: 0.59rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }
</style>
