---
import logo from '../assets/logo-monkey-menorca.webp';

interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a class:list={['brand', { 'brand--light': light }]} href="/">
  <img class="brand__logo" src={logo.src} width={logo.width} height={logo.height} alt="Monkey Menorca Jiu Jitsu" />
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex: 0 0 auto;
  }

  .brand__logo {
    width: clamp(8.2rem, 10.5vw, 11.5rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,.18));
  }

  .brand--light .brand__logo {
    padding: .35rem .55rem;
    background: rgba(244,240,231,.94);
    border-radius: .25rem;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,.3));
  }

  @media (max-width: 520px) {
    .brand__logo { width: 7.35rem; }
  }
</style>
