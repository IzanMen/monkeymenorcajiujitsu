---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';
import { getLocale, languageAlternates, localizedPath, stripLocale, ui } from '../i18n';

const locale = getLocale(Astro.url);
const messages = ui[locale];
const nav = messages.nav.map(([href, label]) => ({ href: localizedPath(href, locale), label }));
const path = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
const alternates = languageAlternates(Astro.url.pathname);
---

<header class="header" data-header>
  <div class="header__inner">
    <Logo />
    <nav class="desktop-nav" aria-label={messages.navLabel}>
      {nav.map((item) => (
        <a class:list={{ active: isActive(stripLocale(item.href)) }} href={item.href}>{item.label}</a>
      ))}
    </nav>
    <nav class="language-switcher" aria-label={messages.language}>
      {alternates.map((item) => (
        <a class:list={{ active: item.locale === locale }} href={item.href} lang={item.locale} hreflang={item.locale}>
          {item.locale.toUpperCase()}
        </a>
      ))}
    </nav>
    <a class="header__cta" href={whatsappUrl(undefined, locale)} target="_blank" rel="noreferrer">
      <Icon name="whatsapp" size={18} /> {messages.freeClass}
    </a>
    <button class="menu-toggle" type="button" aria-label={messages.openMenu} aria-expanded="false" data-menu-toggle data-open-label={messages.openMenu} data-close-label={messages.closeMenu}>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" data-mobile-menu>
  <nav aria-label={messages.mobileNavLabel}>
    {nav.map((item, index) => (
      <a class:list={{ active: isActive(stripLocale(item.href)) }} href={item.href}>
        <span>{String(index + 1).padStart(2, '0')}</span>{item.label}
      </a>
    ))}
  </nav>
  <nav class="mobile-languages" aria-label={messages.language}>
    {alternates.map((item) => (
      <a class:list={{ active: item.locale === locale }} href={item.href} lang={item.locale} hreflang={item.locale}>
        {item.label}
      </a>
    ))}
  </nav>
  <a class="btn btn--lime" href={whatsappUrl(undefined, locale)} target="_blank" rel="noreferrer">
    {messages.tryFreeClass} <Icon name="arrow" />
  </a>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute('aria-label', open ? button.getAttribute('data-open-label') ?? '' : button.getAttribute('data-close-label') ?? '');
    menu?.classList.toggle('is-open', !open);
    document.body.classList.toggle('menu-open', !open);
  });

  const closeMenu = () => {
    if (button?.getAttribute('aria-expanded') !== 'true') return;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', button.getAttribute('data-open-label') ?? '');
    menu?.classList.remove('is-open');
    document.body.classList.remove('menu-open');
  };

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeMenu();
    button?.focus();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cream) 94%, transparent);
    border-bottom: 1px solid rgba(20, 20, 18, 0.12);
    backdrop-filter: blur(18px);
  }
  :global(body.menu-open) .header {
    position: fixed;
    right: 0;
    left: 0;
    width: 100%;
  }
  .header__inner {
    width: min(100% - 2rem, 92rem);
    height: 5.15rem;
    margin: auto;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.5rem);
  }
  .desktop-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 1.45vw, 1.75rem);
  }
  .desktop-nav a {
    position: relative;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.065em;
    text-decoration: none;
    white-space: nowrap;
  }
  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.45rem;
    width: 100%;
    height: 2px;
    background: var(--lime);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .25s ease;
  }
  .desktop-nav a:hover::after,
  .desktop-nav a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .language-switcher {
    display: flex;
    align-items: center;
    border-left: 1px solid rgba(20,20,18,.18);
    padding-left: .65rem;
  }
  .language-switcher a {
    padding: .35rem .38rem;
    color: rgba(17,17,15,.5);
    font-size: .62rem;
    font-weight: 900;
    text-decoration: none;
  }
  .language-switcher a:hover,
  .language-switcher a.active { color: var(--ink); }
  .language-switcher a.active { box-shadow: inset 0 -2px 0 var(--lime-dark); }
  .header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: white;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    text-decoration: none;
    white-space: nowrap;
  }
  .menu-toggle {
    position: relative;
    display: none;
    margin-left: auto;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    place-items: center;
    cursor: pointer;
  }
  .menu-toggle span {
    position: absolute;
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--lime);
    transition: transform .25s ease;
  }
  .menu-toggle span:first-child { transform: translateY(-4px); }
  .menu-toggle span:last-child { transform: translateY(4px); }
  .menu-toggle[aria-expanded="true"] span:first-child { transform: rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:last-child { transform: rotate(-45deg); }
  .mobile-menu {
    display: none;
    position: fixed;
    top: var(--header-height);
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 45;
    padding: 2rem 1rem 7rem;
    background: var(--ink);
    overflow-y: auto;
  }
  .mobile-menu nav { display: grid; }
  .mobile-menu nav a {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: .85rem 0;
    border-bottom: 1px solid rgba(255,255,255,.1);
    color: var(--cream);
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mobile-menu nav a span {
    color: var(--lime);
    font-family: var(--font-body);
    font-size: .68rem;
    letter-spacing: .1em;
  }
  .mobile-menu .btn { margin-top: 2rem; width: 100%; }
  .mobile-menu .mobile-languages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 1.5rem;
    border: 1px solid rgba(255,255,255,.18);
  }
  .mobile-menu .mobile-languages a {
    display: grid;
    place-items: center;
    min-height: 3rem;
    padding: .5rem;
    border: 0;
    border-right: 1px solid rgba(255,255,255,.18);
    color: rgba(255,255,255,.55);
    font-family: var(--font-body);
    font-size: .65rem;
    letter-spacing: 0;
  }
  .mobile-menu .mobile-languages a:last-child { border-right: 0; }
  .mobile-menu .mobile-languages a.active { background: var(--lime); color: var(--ink); }
  @media (max-width: 1200px) {
    .desktop-nav, .language-switcher, .header__cta { display: none; }
    .menu-toggle { display: grid; }
    .mobile-menu.is-open { display: block; animation: menu-in .25s ease-out both; }
  }
  @media (max-width: 720px) {
    .header__inner {
      height: var(--header-height);
      width: calc(100% - 2rem);
    }
    .menu-toggle { width: 2.85rem; height: 2.85rem; }
    .mobile-menu {
      padding: 1.1rem 1rem max(2rem, env(safe-area-inset-bottom));
    }
    .mobile-menu nav a {
      gap: 1rem;
      padding-block: .72rem;
      font-size: clamp(1.8rem, 8vw, 2.55rem);
    }
    .mobile-menu .mobile-languages { margin-top: 1.1rem; }
    .mobile-menu .btn { margin-top: 1.25rem; }
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-.65rem); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
